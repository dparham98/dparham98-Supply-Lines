[gd_scene format=3]
[ext_resource type="Script" path="res://scripts/components/character_animator.gd" id="animator"]
[ext_resource type="PackedScene" path="res://assets/models/units/infantry.glb" id="rig"]
[ext_resource type="Shader" path="res://assets/shaders/chainsaw_teeth.gdshader" id="teeth_shader"]
[sub_resource type="ShaderMaterial" id="teeth_material"]
shader = ExtResource("teeth_shader")
[node name="InfantryModel" type="Node3D"]
script = ExtResource("animator")
player_path = NodePath("Rig/AnimationPlayer")
work_clip = &"Hack"
teeth_path = NodePath("Rig/infantry_rig2/Skeleton3D/chainsaw/chainsaw_teeth_rig")
[node name="Rig" parent="." instance=ExtResource("rig")]
transform = Transform3D(-1,0,0,0,1,0,0,0,-1,0,0,0)
[node name="chainsaw_teeth_rig" parent="Rig/infantry_rig2/Skeleton3D/chainsaw" index="0"]
material_override = SubResource("teeth_material")
[editable path="Rig"]
