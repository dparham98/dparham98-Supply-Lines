[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/components/spell_animator.gd" id="animator"]
[ext_resource type="AnimationLibrary" path="res://assets/models/units/grail_sentinel_cast.tres" id="cast"]
[ext_resource type="PackedScene" path="res://scenes/models/sentinel_cast_mist_fx.tscn" id="mist_fx"]
[ext_resource type="PackedScene" path="res://scenes/models/sentinel_cast_slow_fx.tscn" id="slow_fx"]
[ext_resource type="PackedScene" path="res://assets/models/units/grail_sentinel.glb" id="rig"]

[node name="GrailSentinelModel" type="Node3D"]
script = ExtResource("animator")
player_path = NodePath("Rig/AnimationPlayer")
idle_clip = &"Rest"
run_clip = &"Run"
run_reference_speed = 2.8
muzzle_bone = &"muzzle"
cast_library = ExtResource("cast")
cast_fx = Dictionary[StringName, PackedScene]({
&"mist": ExtResource("mist_fx"),
&"slow": ExtResource("slow_fx"),
&"stimulus": ExtResource("mist_fx")
})

[node name="Rig" parent="." instance=ExtResource("rig")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)
