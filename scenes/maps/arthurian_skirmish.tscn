[node name="ArthurianSkirmish" type="Node3D" groups=["skirmish"]]
editor_description = "Arthurian Knights showcase and playable skirmish with Keep, Chapterhouse placeholder, and all possessed 3D faction assets."
script = ExtResource("game")
tracer_scene = ExtResource("tracer")
pile_scene = ExtResource("pile")
playtest_tools = true
message = "Select your Keep, Chapterhouse, or Knights. B -> K plans a Forward Keep (50W + 50I)."

