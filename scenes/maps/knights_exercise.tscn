[node name="Sites" type="Node3D" parent="."]
editor_description = "Where each side is meant to settle. Markers: the map test measures from them, and the enemy player scouts the ones it has not seen."
[node name="PlayerStart" type="Marker3D" parent="Sites"]
editor_description = "Start A. The player's Depot stands here, 8 m north of the yard's centre so the home mine is about 19 m away (playtest of 2026-11-17)."
position = Vector3(-184,0,-8)
gizmo_extents = 6.0
[node name="EnemyStart" type="Marker3D" parent="Sites"]
editor_description = "Start B: start A mirrored left to right. The enemy player starts here (EnemyDepot)."
