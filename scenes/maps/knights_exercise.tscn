[node name="PlayerAI" type="Node" parent="."]
process_mode = 4
editor_description = "The same AI for the West start, switched off. A spectated match from the main menu switches it on (docs/MAIN_MENU.md)."
script = ExtResource("enemy_ai")
team = "player"
opponent = "enemy"
