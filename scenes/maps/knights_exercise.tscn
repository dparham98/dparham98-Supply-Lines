[node name="KnightsExercise" type="Node3D" groups=["skirmish"]]
editor_description = "Built by scripts/tools/build_playtest_exercises.gd (docs/PLAYTEST_EXERCISES.md) from Two Lakes: the Knights hold the West start with their Stage 2 and 3 buildings, track laid to a second Keep, and an enemy guard and two enemy mines to the east."
script = ExtResource("game")
tracer_scene = ExtResource("tracer")
pile_scene = ExtResource("pile")
vehicle_fuel_required = true
testing_coal_amount = 0
playtest_tools = true
testing_iron_grant = false
testing_full_tanks = false
message = "Knights exercise: Keep, Chapterhouse, Forge, Dragon Yard and Houses at home; track runs to Keep B. Enemy guard and two hidden enemy mines to the east."
[node name="DepotNetwork" type="Node" parent="."]
script = ExtResource("network")
depot_scene = ExtResource("depot")
truck_scene = ExtResource("truck")
