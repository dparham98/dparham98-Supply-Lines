[node name="Stage2Exercise" instance=ExtResource("base")]
editor_description = "Built by scripts/tools/build_stage2_exercise.gd (docs/STAGE2_EXERCISE.md): Two Lakes with both factions' Stage 2 and 3 buildings and units on the player's side, and an enemy guard to try them on."
message = "Stage 2/3 exercise: Cyborgs by the Depot, Knights by the Keeps to the north. Enemy guard to the east. See docs/STAGE2_EXERCISE.md."
