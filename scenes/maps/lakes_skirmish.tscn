[node name="LakesSkirmish" type="Node3D" groups=["skirmish"]]
editor_description = "Two Lakes (docs/TWO_LAKES_MAP.md): six starts, a forested Crossing between two lakes in the middle and open ways round them. The player holds the West start; the East start has no opponent yet, only the EnemyStart marker and one enemy of each unit type. The east is the west mirrored: move a marker and move its partner to the same z with x negated."
script = ExtResource("game")
tracer_scene = ExtResource("tracer")
pile_scene = ExtResource("pile")
vehicle_fuel_required = true
testing_coal_amount = 0
playtest_tools = true
testing_iron_grant = false
testing_full_tanks = false
message = "Your mine is north of the Depot. The road east is shut by forest: go round a lake, or cut in."
[node name="DepotNetwork" type="Node" parent="."]
script = ExtResource("network")
depot_scene = ExtResource("depot")
truck_scene = ExtResource("truck")
