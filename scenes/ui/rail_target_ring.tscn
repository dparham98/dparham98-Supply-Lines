[node name="RailTargetRing" type="Node3D"]
editor_description = "Shown around each rail target while track is planned (docs/RAIL_PLANNING.md). Scaled to the target's connect radius; track connects once its edge touches the ring."

[node name="Open" type="MeshInstance3D" parent="."]
mesh = SubResource("open_mesh")
cast_shadow = 0

[node name="Connected" type="MeshInstance3D" parent="."]
visible = false
mesh = SubResource("connected_mesh")
cast_shadow = 0
